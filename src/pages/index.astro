---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="pt-14 pb-10 sm:pt-20 sm:pb-14">
      <p
        class="glass-card text-muted-foreground inline-flex items-center gap-2 rounded-full px-4 py-1.5 font-mono text-sm"
      >
        <span class="relative flex size-2">
          <span
            class="bg-accent-2 absolute inline-flex size-full animate-ping rounded-full opacity-75"
          ></span>
          <span class="bg-accent-2 relative inline-flex size-2 rounded-full"
          ></span>
        </span>
        <span><span class="text-accent">~/rosalin</span> $ whoami</span>
      </p>
      <p class="text-accent mt-8 font-mono text-sm sm:text-base">
        &gt; ssh rosalin@portfolio
      </p>
      <h1 class="mt-3 text-5xl leading-[1.05] font-bold sm:text-7xl">
        Hello, <span class="text-gradient italic">World</span><span
          class="cursor-blink text-accent font-mono not-italic"
          aria-hidden="true">_</span
        >
      </h1>
      <p
        class="text-muted-foreground mt-6 max-w-xl text-lg leading-relaxed sm:text-xl"
      >
        I'm <span class="text-foreground font-semibold">Rosalin Dash</span>, a
        Senior Full Stack <span class="text-foreground font-mono">.NET</span> &amp;{
          " "
        }
        <span class="text-foreground font-mono">AI</span> Engineer with 10+ years
        shipping software for banking and insurance. I build event-driven microservices
        by day and LLM multi-agent systems by curiosity &mdash; and write about what
        I build, break and learn.
      </p>
      <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tech stack">
        {
          [
            "C#",
            ".NET Core",
            "Angular",
            "Vue.js",
            "Kafka",
            "Azure",
            "LangGraph",
            "RAG",
          ].map(tech => (
            <li class="bg-muted text-muted-foreground rounded-md px-2.5 py-1 font-mono text-xs">
              {tech}
            </li>
          ))
        }
      </ul>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href={getRelativeLocaleUrl(locale, "posts")}
          class="from-accent to-accent-2 text-accent-foreground inline-flex items-center gap-2 rounded-full bg-linear-to-r px-6 py-3 font-semibold shadow-lg transition hover:scale-[1.03] hover:shadow-xl"
        >
          Read the blog
          <IconArrowRight class="inline-block size-5 rtl:-rotate-180" />
        </a>
        <a
          href={getRelativeLocaleUrl(locale, "about")}
          class="glass-card hover:border-accent/60 inline-flex items-center rounded-full px-6 py-3 font-semibold transition"
        >
          About me
        </a>
        <a
          target="_blank"
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          class="glass-card hover:border-accent/60 inline-flex size-12 items-center justify-center rounded-full transition"
          aria-label="RSS Feed"
          title="RSS Feed"
        >
          <IconRss
            width={20}
            height={20}
            class="stroke-accent stroke-2 rtl:-rotate-90"
          />
        </a>
      </div>

      {
        socials.length > 0 && (
          <div class="text-muted-foreground mt-8 flex items-center gap-3 text-sm max-sm:flex-col max-sm:items-start">
            <span class="whitespace-nowrap">{t.home.socialLinks}:</span>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class:list={["pt-8 pb-6"]}>
          <h2 class="flex items-center gap-4 text-3xl font-bold">
            {t.home.featured}
            <span class="from-accent/60 h-px flex-1 bg-linear-to-r to-transparent" />
          </h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-8 pb-6">
          <h2 class="flex items-center gap-4 text-3xl font-bold">
            {t.home.recentPosts}
            <span class="from-accent/60 h-px flex-1 bg-linear-to-r to-transparent" />
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-10 text-center">
      <LinkButton
        href={getRelativeLocaleUrl(locale, "posts")}
        class="glass-card hover:border-accent/60 rounded-full px-6 py-3 font-semibold transition"
      >
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
